<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <receiver
            android:name=".PlayerWidget"
            android:exported="false"
            android:label="@string/widget_player_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_player_info" />
        </receiver>

        <receiver
            android:name=".PlayerSmallWidget"
            android:exported="false"
            android:label="@string/widget_player_small_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_player_small_info" />
        </receiver>

        <receiver
            android:name=".PlaylistWidget"
            android:exported="false"
            android:label="@string/widget_playlist_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_playlist_info" />
        </receiver>

        <receiver
            android:name=".WidgetActionReceiver"
            android:exported="false" />

        <!-- Started by the launcher when a playlist widget is placed or reconfigured. -->
        <activity
            android:name=".PlaylistWidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Navi.WidgetConfig">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>
</manifest>
