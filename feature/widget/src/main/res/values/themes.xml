<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Navi.WidgetConfig" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="WidgetDot">
        <item name="android:layout_width">7dp</item>
        <item name="android:layout_height">7dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:src">@drawable/widget_dot_off</item>
    </style>
</resources>
