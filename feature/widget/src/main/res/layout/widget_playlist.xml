<?xml version="1.0" encoding="utf-8"?>
<!-- 4×1 pinned playlist: name in dot-matrix type, song count, and a play button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_accent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="22dp"
    android:paddingEnd="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_playlist_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-black"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="@string/widget_playlist_label"
            android:textAllCaps="true"
            android:textColor="#FFFFFFFF"
            android:textSize="24sp" />

        <ImageView
            android:id="@+id/widget_playlist_name_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:scaleType="fitStart"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_playlist_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:letterSpacing="0.12"
            android:singleLine="true"
            android:textAllCaps="true"
            android:textColor="#FFFFFFFF"
            android:textSize="10sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_playlist_play"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/widget_circle_white"
        android:contentDescription="@string/cd_play"
        android:scaleType="center"
        android:src="@drawable/ic_play"
        android:tint="#FF000000" />
</LinearLayout>
