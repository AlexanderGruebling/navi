<?xml version="1.0" encoding="utf-8"?>
<!-- Self-hosted servers on the LAN often run without TLS (e.g. http://192.168.0.88:4533), so plain HTTP is allowed.
     The login screen warns when an http:// address is entered. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
